# BayAnalytics backend configuration. Copy to backend/.env (git-ignored), replace every
# placeholder before you `source` it (a literal "<...>" breaks the shell), and export it:
#     set -a; source .env; set +a
# Every key is optional. Memory thresholds and KV precision are provisional planning inputs:
# replace them with values measured by scripts/benchmark_local.py on the reference machine.
# There are no mock or fixture modes; every component here is the real one.

# --- server ---------------------------------------------------------------------------
BAY_HOST=127.0.0.1            # loopback by default; never expose publicly without auth
BAY_PORT=8000
BAY_DEPLOYMENT=local          # local | cloud
BAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BAY_LOG_LEVEL=INFO
BAY_API_PREFIX=/api/v1
BAY_API_KEY=                  # required when BAY_HOST is not loopback; clients send Authorization: Bearer <key> or X-API-Key
BAY_MAX_ACTIVE_ANALYSES=4     # admission control; further POST /analyses get 429 TOO_MANY_ANALYSES
BAY_MAX_REQUEST_BODY_BYTES=65536       # JSON bodies (Content-Length gate)
BAY_MAX_UPLOAD_BYTES=26214400          # audio uploads
BAY_HEALTH_CACHE_S=2          # /health component probe cache
BAY_SSE_KEEPALIVE_S=15        # SSE keepalive comment interval (lower it behind proxies with short idle timeouts)
BAY_GRACEFUL_SHUTDOWN_S=10    # uvicorn waits this long for open streams on stop, then running analyses are INTERRUPTED

# --- persistence (Railway Postgres, project "bayanalytics") ---------------------------
# Build the URL from the Railway dashboard (service "Postgres" -> Variables): POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DB, with the public TCP proxy host below from your Mac (inside
# Railway use the private DATABASE_URL the service exposes). Keep sslmode=require: the image
# uses a self-signed certificate. Leave empty to use the in-memory store (development only).
DATABASE_URL=
# e.g. DATABASE_URL=postgresql://postgres:PASSWORD@altaria.proxy.rlwy.net:14222/railway?sslmode=require
BAY_DATABASE_POOL_MIN=1
BAY_DATABASE_POOL_MAX=4

# --- research -------------------------------------------------------------------------
BAY_RESEARCH_SEARCH_URL=      # SearXNG base URL (the search backend carried over from GNSIS_SEARCH_URL), e.g. http://127.0.0.1:8080; empty disables web search (EDGAR + Stooq only, logged at startup)
BAY_RESEARCH_CONTACT_EMAIL=   # required by SEC EDGAR fair-access policy (sent in User-Agent)
BAY_RESEARCH_USER_AGENT=BayAnalytics/0.1
BAY_RESEARCH_CACHE_DIR=       # optional on-disk fetch cache (SEC and Stooq bodies only, 24 h sweep)
BAY_RESEARCH_MAX_ROUNDS=4
BAY_RESEARCH_MAX_SOURCES=24
BAY_RESEARCH_MAX_FETCH_PER_ROUND=6
BAY_RESEARCH_TIMEOUT_S=240    # whole retrieval loop
BAY_RESEARCH_FETCH_TIMEOUT_S=20
BAY_RESEARCH_MIN_REQUEST_INTERVAL_S=0.25
BAY_RESEARCH_PRICE_HISTORY_DAYS=1830
BAY_EVAL_AS_OF=               # ISO timestamp: freeze the information set (historical evaluation)

# --- laya (persistent Node worker, @receptron/laya@0.1.2) ----------------------------
BAY_LAYA_NODE_BIN=node
BAY_LAYA_WORKER_DIR=          # defaults to the packaged src/bayanalytics/laya/worker
BAY_LAYA_MODEL_DIR=           # local ONNX bundle dir (printed by scripts/install_laya_worker.sh); empty = cache/download
BAY_LAYA_CACHE_DIR=           # same directory as LAYA_CACHE when you ran install_laya_worker.sh
BAY_LAYA_THREADS=4
BAY_LAYA_LOAD_TIMEOUT_S=900
BAY_LAYA_REQUEST_TIMEOUT_S=120
BAY_LAYA_MAX_RESTARTS=1       # one controlled restart per backend process lifetime

# --- spark (llama.cpp >= b10828, XHToken/Spark-X2.5-1.7B-GGUF Q4_K_M) -----------------
BAY_SPARK_MODE=managed        # managed (the backend starts llama-server) | external (a server you run)
BAY_SPARK_SERVER_URL=http://127.0.0.1:8081
BAY_SPARK_API_KEY=            # managed: llama-server key (random per process when empty); external: that server's key
BAY_SPARK_LLAMA_SERVER_BIN=   # from scripts/setup_llama_cpp.sh
BAY_SPARK_MODEL_PATH=         # from scripts/download_spark.py
BAY_SPARK_LOCKFILE=models/spark.lock.json
BAY_SPARK_THREADS=4
BAY_SPARK_FAST_CTX=32768
BAY_SPARK_DEEP_CTX=131072
BAY_SPARK_FAST_KV=f16         # choose from measurement
BAY_SPARK_DEEP_KV=q4_0        # provisional; choose from measurement
BAY_SPARK_DEEP_MIN_AVAILABLE_MB=4096   # provisional planning threshold, replace after measuring
BAY_SPARK_FAST_MIN_AVAILABLE_MB=1536
BAY_SPARK_MAX_OUTPUT_TOKENS=1400
BAY_SPARK_TEMPERATURE=0.2
BAY_SPARK_UNDERSTANDING_MAX_TOKENS=192  # Spark pass 1: short JSON interpretation of the question
BAY_SPARK_START_TIMEOUT_S=300
BAY_SPARK_REQUEST_TIMEOUT_S=900

# --- whisper (optional voice input) ---------------------------------------------------
BAY_WHISPER_MODE=disabled     # cli | disabled
BAY_WHISPER_BIN=              # from scripts/setup_whisper.sh
BAY_WHISPER_MODEL_PATH=
BAY_WHISPER_THREADS=4
BAY_FFMPEG_BIN=ffmpeg         # needed for any upload that is not 16 kHz mono WAV
BAY_WHISPER_TIMEOUT_S=120
