# BayAnalytics backend configuration. Copy to backend/.env (git-ignored) and export, or pass
# through your process manager. Every key is optional. Memory thresholds and KV precision are
# provisional planning inputs: replace them with values measured by scripts/benchmark_local.py.

# --- server ---------------------------------------------------------------------------
BAY_HOST=127.0.0.1            # loopback by default; never expose publicly without auth
BAY_PORT=8000
BAY_DEPLOYMENT=local          # local | cloud
BAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BAY_LOG_LEVEL=INFO
BAY_API_KEY=                  # required when BAY_HOST is not loopback; clients send Authorization: Bearer <key>
BAY_MAX_ACTIVE_ANALYSES=4     # admission control; further POST /analyses get 429 TOO_MANY_ANALYSES

# --- persistence (Railway Postgres, project "bayanalytics") ---------------------------
# Copy DATABASE_PUBLIC_URL / DATABASE_URL from the Railway dashboard (service "Postgres").
# From your Mac use the public TCP proxy host; inside Railway use the private domain.
# The image uses a self-signed certificate, so keep sslmode=require.
DATABASE_URL=postgresql://postgres:<password>@altaria.proxy.rlwy.net:14222/railway?sslmode=require
BAY_DATABASE_POOL_MIN=1
BAY_DATABASE_POOL_MAX=4

# --- research -------------------------------------------------------------------------
BAY_RESEARCH_PROVIDER=http    # http | fixture
BAY_RESEARCH_SEARCH_URL=      # SearXNG base URL (carried over from GNSIS_SEARCH_URL), e.g. http://127.0.0.1:8080
BAY_RESEARCH_CONTACT_EMAIL=   # required by SEC EDGAR fair-access policy (sent in User-Agent)
BAY_RESEARCH_CACHE_DIR=       # optional on-disk fetch cache
BAY_RESEARCH_MAX_ROUNDS=4
BAY_RESEARCH_MAX_SOURCES=24
BAY_RESEARCH_FIXTURE_DIR=     # only with BAY_RESEARCH_PROVIDER=fixture
BAY_EVAL_AS_OF=               # ISO timestamp: freeze the information set (historical evaluation)

# --- laya (persistent Node worker, @receptron/laya@0.1.2) ----------------------------
BAY_LAYA_MODE=worker          # worker | mock
BAY_LAYA_NODE_BIN=node
BAY_LAYA_MODEL_DIR=           # local ONNX bundle dir; empty = HF cache
BAY_LAYA_CACHE_DIR=
BAY_LAYA_THREADS=4

# --- spark (llama.cpp >= b10828, XHToken/Spark-X2.5-1.7B-GGUF Q4_K_M) -----------------
BAY_SPARK_MODE=managed        # managed | external | mock
BAY_SPARK_SERVER_URL=http://127.0.0.1:8081
BAY_SPARK_LLAMA_SERVER_BIN=   # from scripts/setup_llama_cpp.sh
BAY_SPARK_MODEL_PATH=         # from scripts/download_spark.py
BAY_SPARK_LOCKFILE=models/spark.lock.json
BAY_SPARK_THREADS=4
BAY_SPARK_FAST_CTX=32768
BAY_SPARK_DEEP_CTX=131072
BAY_SPARK_FAST_KV=f16         # choose from measurement
BAY_SPARK_DEEP_KV=q4_0        # provisional; choose from measurement
BAY_SPARK_DEEP_MIN_AVAILABLE_MB=4096   # provisional planning threshold, replace after measuring
BAY_SPARK_FAST_MIN_AVAILABLE_MB=1536

# --- whisper (optional voice input) ---------------------------------------------------
BAY_WHISPER_MODE=disabled     # cli | mock | disabled
BAY_WHISPER_BIN=
BAY_WHISPER_MODEL_PATH=
